generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SavedEmbed {
  id        String   @id @db.VarChar(12)
  userId    String?
  title     String   @default("")
  mode      String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buttonActions ButtonAction[]

  @@index([userId])
}

model ButtonAction {
  id        String   @id @default(cuid())
  embedId   String?
  messageId String?
  buttonId  String
  label     String
  style     Int      @default(1)
  actions   Action[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  embed     SavedEmbed? @relation(fields: [embedId], references: [id], onDelete: Cascade)

  @@unique([buttonId])
  @@index([embedId])
  @@index([messageId])
}

model Action {
  id             String       @id @default(cuid())
  buttonActionId String
  buttonAction   ButtonAction @relation(fields: [buttonActionId], references: [id], onDelete: Cascade)
  order          Int          // порядок выполнения
  type           String       // do_nothing, wait, add_role, remove_role, toggle_role, send_message, send_webhook, create_thread, set_variable, delete_message, stop
  config         Json         @default("{}")
  createdAt      DateTime     @default(now())

  @@index([buttonActionId])
  @@index([buttonActionId, order])
}

model ChatSession {
  id        String        @id @db.VarChar(12)
  userId    String
  title     String        @default("New Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

model UnlimitedUser {
  discordId String   @id
  addedBy   String
  createdAt DateTime @default(now())
}

model AppUser {
  discordId     String   @id
  username      String
  displayName   String   @default("")
  avatar        String?
  firstLogin    DateTime @default(now())
  lastLogin     DateTime @default(now())
  aiRequests    Int      @default(0)
  embedsCreated Int      @default(0)
  webhooksSent  Int      @default(0)
  lastActive    DateTime @default(now())

  @@index([lastLogin])
}
